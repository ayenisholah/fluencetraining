# ---- docker compose (.env) -------------------------------------------------
# Generate each secret with: openssl rand -hex 32
CONVEX_INSTANCE_SECRET=
N8N_ENCRYPTION_KEY=
# Separate secrets per direction, so a leaked n8n-side secret cannot be used
# to forge events towards n8n and vice versa.
LENDLOOP_TO_N8N_SECRET=
N8N_TO_LENDLOOP_SECRET=
LENDLOOP_APP_URL=http://localhost:3000
LENDLOOP_OPS_EMAIL=ops@lendloop.local
