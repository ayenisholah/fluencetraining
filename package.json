{
  "name": "lendloop",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project convex --project ui --project n8n",
    "test:watch": "vitest",
    "convex": "convex dev",
    "setup": "bash scripts/setup.sh",
    "seed": "convex run dev:seedNeighbourhood",
    "n8n:import": "bash scripts/n8n-import.sh",
    "n8n:export": "bash scripts/n8n-export.sh",
    "check:bundle": "bash scripts/check-client-bundle.sh",
    "check:contrast": "node scripts/contrast-check.mjs",
    "check:links": "node scripts/check-links.mjs",
    "email:preview": "node scripts/email-preview.mjs",
    "test:ui": "vitest run --project ui",
    "test:convex": "vitest run --project convex",
    "test:n8n": "vitest run --project n8n",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --project storybook",
    "test:e2e": "playwright test",
    "test:automation": "LENDLOOP_TEST_SMTP_OUTAGE=1 playwright test e2e/automation.spec.ts --project signed-in --workers=1 --trace off",
    "test:concurrency": "playwright test --project concurrency --workers=1",
    "test:concurrency:ui": "playwright test --project concurrency-ui --workers=1",
    "test:responsive": "playwright test --project responsive --workers=1 --output=playwright-responsive-results",
    "test:e2e:public": "playwright test --project public --project public-mobile",
    "test:n8n:provider": "python3 scripts/test_n8n_provider.py",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.49.0",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@clerk/testing": "^2.2.53",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/nextjs-vite": "^10.6.5",
    "@tailwindcss/turbopack": "^4",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^5.1.0",
    "axe-core": "^4.14.0",
    "convex-test": "^0.0.67",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "storybook": "^10.6.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,mts,js,cjs}": [
      "prettier --write",
      "eslint --max-warnings=0 --no-warn-ignored --fix"
    ],
    "*.{json,css,yml,yaml}": "prettier --write"
  }
}
