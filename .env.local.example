# ---- Next.js + Convex CLI (.env.local) -------------------------------------
# Self-hosted Convex (docker compose). Admin key: npm run convex:admin-key
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210

# Clerk (dashboard -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional: cookie-free analytics (Plausible or a compatible self-hosted instance).
# Loads only after the visitor allows analytics in the cookie banner.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.tagged-events.js

# Public site URL used for canonical links, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
